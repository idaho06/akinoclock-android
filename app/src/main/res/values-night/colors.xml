<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Braun BC12 "BC12B" dark palette (default) -->
    <color name="bezel_ring">#2A2A2A</color>
    <color name="numeral">#EDEDED</color>
    <color name="tick_minute">#8A8A8A</color>
    <color name="hand_baton">#EDEDED</color>
    <color name="hand_tip">#C9E6C0</color>
    <color name="second_hand">#F5C400</color>
    <color name="center_cap_ring">#101010</color>
    <!-- Deliberately its own tone, not @color/tick_minute: dark here, bright in values/,
         the inverse of tick_minute's similar brightness in both themes. -->
    <color name="alarm_hand">#4A4A4A</color>
    <!-- Darker, more saturated green than @color/hand_tip so the alarm pill reads as a
         distinct accent from the hour/minute tips. -->
    <color name="alarm_tip">#5FA85A</color>

    <color name="background">#101010</color>

    <!-- Calendar: reuses the dial's existing accent colors rather than introducing new ones. -->
    <color name="calendar_today">@color/hand_tip</color>
    <color name="calendar_accent">@color/second_hand</color>
    <color name="calendar_dim">@color/tick_minute</color>
    <!-- Always dark: readable against the pale green today circle in both themes. -->
    <color name="calendar_today_text">#151515</color>
</resources>
